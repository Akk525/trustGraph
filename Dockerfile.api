# TrustGraph API image — FastAPI served by uvicorn.
# Does NOT include Foundry, scanner execution, or the worker entrypoint.
# Set TRUSTGRAPH_EMBEDDED_WORKER=false in the ECS task definition environment.

FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml ./
COPY trustgraph/ ./trustgraph/
COPY trustgraph_cloud/ ./trustgraph_cloud/

RUN pip install --no-cache-dir ".[cloud]"

RUN useradd -m -u 1001 -s /bin/bash api

USER api

EXPOSE 8000

CMD ["uvicorn", "trustgraph_cloud.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
