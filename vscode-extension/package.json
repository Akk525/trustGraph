{
  "name": "trustgraph",
  "displayName": "TrustGraph",
  "description": "Deterministic Solidity trust-boundary analysis with reproducible Foundry proof tests.",
  "version": "0.1.0",
  "publisher": "akk525",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akk525/trustGraph"
  },
  "bugs": {
    "url": "https://github.com/Akk525/trustGraph/issues"
  },
  "homepage": "https://github.com/Akk525/trustGraph#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Other"
  ],
  "icon": "media/trustgraph-icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "keywords": [
    "solidity",
    "smart-contract-security",
    "foundry",
    "static-analysis",
    "ethereum",
    "defi-security",
    "vscode-extension",
    "developer-tooling",
    "smart-contracts"
  ],
  "activationEvents": [
    "onLanguage:solidity",
    "workspaceContains:**/*.sol"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "trustgraph.runAudit",
        "title": "TrustGraph: Run Audit",
        "icon": "$(play)"
      },
      {
        "command": "trustgraph.openFindings",
        "title": "Open Detail",
        "category": "TrustGraph"
      },
      {
        "command": "trustgraph.goToSource",
        "title": "Go to Source",
        "category": "TrustGraph",
        "icon": "$(go-to-file)"
      },
      {
        "command": "trustgraph.copyPatch",
        "title": "Copy Patch",
        "category": "TrustGraph",
        "icon": "$(clippy)"
      },
      {
        "command": "trustgraph.openReport",
        "title": "Open Report File",
        "category": "TrustGraph"
      },
      {
        "command": "trustgraph.openProofTest",
        "title": "Open Proof Test",
        "category": "TrustGraph",
        "icon": "$(beaker)"
      },
      {
        "command": "trustgraph.clearFindings",
        "title": "TrustGraph: Clear Findings",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": {
      "title": "TrustGraph",
      "properties": {
        "trustgraph.contractPath": {
          "type": "string",
          "default": "",
          "description": "Path to a .sol file or directory of Solidity source files. Defaults to workspace root."
        },
        "trustgraph.outputDir": {
          "type": "string",
          "default": ".trustgraph",
          "description": "Directory for reports and generated tests (relative to workspace root or absolute)."
        },
        "trustgraph.runFoundry": {
          "type": "boolean",
          "default": false,
          "description": "Execute forge test after generating proof tests."
        },
        "trustgraph.generateTest": {
          "type": "boolean",
          "default": true,
          "description": "Generate Foundry proof tests for trust-boundary findings."
        },
        "trustgraph.reportFormat": {
          "type": "string",
          "enum": [
            "markdown",
            "json",
            "both"
          ],
          "default": "both",
          "description": "Report output format."
        },
        "trustgraph.cliPath": {
          "type": "string",
          "default": "",
          "description": "Full path to the trustgraph CLI binary. Leave empty to use PATH lookup."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trustgraph",
          "title": "TrustGraph",
          "icon": "media/trustgraph-icon.svg"
        }
      ]
    },
    "views": {
      "trustgraph": [
        {
          "id": "trustgraph.findings",
          "name": "Findings"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "trustgraph.runAudit",
          "when": "view == trustgraph.findings",
          "group": "navigation@1"
        },
        {
          "command": "trustgraph.clearFindings",
          "when": "view == trustgraph.findings",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "trustgraph.openFindings",
          "when": "viewItem =~ /^trustgraphFinding/",
          "group": "1_detail@1"
        },
        {
          "command": "trustgraph.goToSource",
          "when": "viewItem =~ /^trustgraphFinding/",
          "group": "1_detail@2"
        },
        {
          "command": "trustgraph.openProofTest",
          "when": "viewItem =~ /proofTest/",
          "group": "2_test@1"
        },
        {
          "command": "trustgraph.copyPatch",
          "when": "viewItem =~ /patch/",
          "group": "2_test@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "prepackage": "npm run compile && node scripts/check-package-safety.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.3.0"
  }
}